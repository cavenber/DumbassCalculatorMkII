<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/beige"
    android:layout_marginTop="?attr/actionBarSize"
    android:paddingTop="60dp"
    android:paddingHorizontal="10dp"
    android:layout_marginBottom="?attr/actionBarSize"
    tools:context=".ExpectedValue">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="10dp"
        android:gravity="center"
        android:textSize="28sp"
        android:textColor="@color/dark_brown"
        android:fontFamily="@font/milky_vintage"
        android:text="value * probability"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="28sp"
            android:textColor="@color/dark_brown"
            android:fontFamily="@font/milky_vintage"
            android:text="Possibility = " />

        <EditText
            android:id="@+id/ev_possibility"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:hint="Value,Probability"
            android:textColorHint="@color/pale_brown"
            android:focusable="false"
            android:inputType="none"
            android:maxLines="1"
            android:textColor="@color/brown"
            android:textSize="28sp"
            android:fontFamily="@font/milky_vintage"
            android:backgroundTint="@color/dark_brown" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textColor="@color/dark_brown"
            android:fontFamily="@font/milky_vintage"
            android:text="Values = " />

        <TextView
            android:id="@+id/ev_values"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textColor="@color/dark_brown"
            android:fontFamily="@font/milky_vintage"
            android:text="Null" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textColor="@color/dark_brown"
            android:fontFamily="@font/milky_vintage"
            android:text="Total Probability = " />

        <TextView
            android:id="@+id/ev_total_probability"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textColor="@color/dark_brown"
            android:fontFamily="@font/milky_vintage"
            android:text="0.0" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="28sp"
            android:textColor="@color/dark_brown"
            android:fontFamily="@font/milky_vintage"
            android:text="Expected Value = " />

        <EditText
            android:id="@+id/ev_ans"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:hint="Answer"
            android:textColorHint="@color/pale_brown"
            android:inputType="none"
            android:focusable="false"
            android:maxLines="1"
            android:textColor="@color/brown"
            android:textSize="28sp"
            android:fontFamily="@font/milky_vintage"
            android:backgroundTint="@color/dark_brown" />

    </LinearLayout>

    <include
        layout="@layout/input_base"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"/>

</LinearLayout>